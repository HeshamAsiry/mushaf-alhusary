# ============================================================
# Mushaf Al-Husary - Environment Variables
# ============================================================
# COPY this file to .env.local when running locally.
# NEVER put real secrets in GitHub source code.
#
# Neon:
# 1) Open Neon Console
# 2) Open project: young-brook-54728721
# 3) Click "Connect"
# 4) Copy the PostgreSQL connection string
DATABASE_URL="PASTE_NEON_CONNECTION_STRING_HERE"

# Cloudflare R2:
# R2_ACCOUNT_ID:
#   Cloudflare Dashboard -> R2 -> Overview -> Account ID
R2_ACCOUNT_ID="PASTE_CLOUDFLARE_ACCOUNT_ID_HERE"

# R2_ACCESS_KEY_ID:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
#   Use the Access Key ID from the token you created.
R2_ACCESS_KEY_ID="PASTE_R2_ACCESS_KEY_ID_HERE"

# R2_SECRET_ACCESS_KEY:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
#   Use the Secret Access Key shown when the token was created.
#   WARNING: treat this as a password. Never commit the real value.
R2_SECRET_ACCESS_KEY="PASTE_R2_SECRET_ACCESS_KEY_HERE"

# R2_BUCKET_NAME:
#   Cloudflare Dashboard -> R2 -> your bucket
#   Enter the exact bucket name here.
R2_BUCKET_NAME="PASTE_YOUR_R2_BUCKET_NAME_HERE"

# Optional: keep this false until public delivery is explicitly configured.
R2_PUBLIC_ENABLED="false"
